{
  "name": "anonfeedback",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "npm run migrate && concurrently -n web,api -c cyan,green \"npm run dev\" \"npm run dev:backend\"",
    "install:all": "npm install && npm --prefix backend install",
    "db:setup": "npm --prefix backend run db:setup",
    "migrate": "npm --prefix backend run migrate",
    "make-admin": "npm --prefix backend run make-admin --"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.5.6",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "^4.1.11",
    "lightningcss-win32-x64-msvc": "^1.30.1"
  }
}
