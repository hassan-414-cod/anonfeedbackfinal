{
  "name": "anonfeedback-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Knex + PostgreSQL API for AnonFeedback",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:create": "node scripts/db-create.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "db:setup": "node scripts/db-create.js && knex migrate:latest && knex seed:run",
    "db:reset": "node scripts/db-reset.js && knex migrate:latest && knex seed:run",
    "make-admin": "node scripts/make-admin.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
