# Copy to backend/.env (never commit it).
PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/anonfeedback

# Frontend origin(s) allowed to call this API (comma separated). Used for CORS + CSRF checks.
FRONTEND_ORIGIN=http://localhost:3000

# Uploaded files (local disk, development only). Relative to backend/.
UPLOAD_DIR=uploads

# Lets the Billing page switch plans without payment. Remove for production.
DEMO_BILLING=true
